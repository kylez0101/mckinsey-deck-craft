          "ref": "data.cost.labor"
        },
        {
          "ref": "data.cost.security"
        },
        {
          "ref": "data.cost.setup"
        }
      ]
    },
    "net": {
      "op": "subtract",
      "args": [
        {
          "ref": "calc.income"
        },
        {
