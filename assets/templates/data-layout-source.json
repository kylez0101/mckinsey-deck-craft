        }
      ]
    },
    "headroom": {
      "op": "subtract",
      "args": [
        {
          "ref": "data.budget"
        },
        {
          "ref": "calc.spend"
        }
      ]
    },
    "lowNet": {
      "op": "subtract",
      "args": [
        {
          "op": "multiply",
          "args": [
            {
              "ref": "calc.income"
            },
            {
              "ref": "data.lowRate"
            }
          ]
        },
        {
          "ref": "calc.spend"
        }
      ]
    },
    "bNet": {
      "op": "subtract",
      "args": [
        {
          "ref": "data.b.income"
        },
        {
          "ref": "data.b.cost"
        }
      ]
    },
    "bLow": {
      "op": "subtract",
      "args": [
        {
          "op": "multiply",
          "args": [
            {
              "ref": "data.b.income"
            },
            {
              "ref": "data.lowRate"
            }
          ]
        },
        {
          "ref": "data.b.cost"
        }
      ]
    },
    "dNet": {
      "op": "subtract",
      "args": [
        {
          "ref": "data.d.income"
        },
        {
          "ref": "data.d.cost"
        }
      ]
    },
    "dLow": {
      "op": "subtract",
      "args": [
        {
          "op": "multiply",
          "args": [
            {
              "ref": "data.d.income"
            },
            {
              "ref": "data.lowRate"
            }
          ]
        },
        {
          "ref": "data.d.cost"
        }
      ]
    },
    "budgetRatio": {
      "op": "divide",
      "args": [
        {
          "ref": "calc.spend"
        },
        {
          "ref": "data.budget"
        }
      ]
    },
    "withinBudget": {
      "op": "lte",
      "args": [
        {
          "ref": "calc.spend"
        },
        {
          "ref": "data.budget"
        }
      ]
    },
    "downsidePositive": {
      "op": "gte",
      "args": [
        {
          "ref": "calc.lowNet"
        },
        0
      ]
    },
    "eligible": {
      "op": "and",
      "args": [
        {
          "ref": "calc.withinBudget"
        },
        {
          "ref": "calc.downsidePositive"
        }
      ]
    },
    "selectedRow": {
      "op": "if",
      "args": [
        {
          "ref": "calc.eligible"
        },
        0,
        {
          "op": "if",
          "args": [
            {
              "op": "and",
              "args": [
                {
                  "op": "lte",
                  "args": [
                    {
                      "ref": "data.b.cost"
                    },
                    {
                      "ref": "data.budget"
                    }
                  ]
                },
                {
                  "op": "gte",
                  "args": [
                    {
                      "ref": "calc.bLow"
                    },
                    0
                  ]
                }
              ]
            },
            1,
            3
          ]
        }
      ]
    },
    "decision": {
      "op": "if",
      "args": [
        {
          "op": "eq",
          "args": [
            {
              "ref": "calc.selectedRow"
            },
            0
          ]
